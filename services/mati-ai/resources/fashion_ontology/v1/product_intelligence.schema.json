      }
    },
    "spatial_value_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/spatial_value"
      }
    },
    "assertion_candidate": {
      "description": "A retained hypothesis for an UNKNOWN assertion, never its effective value.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "evidence_refs"
      ]
    },
    "evidence_source_details": {
      "description": "Optional compatible source metadata. source_kind is an extensible descriptive discriminator; source_type retains the established ontology annotation source.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "scan_session_ref": {
          "type": "string",
          "minLength": 1
        },
        "frame_ref": {
          "type": "string",
          "minLength": 1
        },
        "region_ref": {
          "type": "string",
          "minLength": 1
        },
        "provider_ref": {
          "type": "string",
          "minLength": 1
        },
        "external_product_ref": {
          "type": "string",
          "minLength": 1
        },
        "external_variant_ref": {
          "type": "string",
          "minLength": 1
        },
        "match_assessment_ref": {
          "type": "string",
          "minLength": 1
        },
        "variant_verification_ref": {
          "type": "string",
          "minLength": 1
        },
        "quality_assessment_ref": {
          "type": "string",
          "minLength": 1
        },
        "permission_record_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "frame_timestamp_ms": {
          "type": "number",
          "minimum": 0
        },
        "identity_match_status": {
          "enum": [
            "exact_verified",
            "probable",
            "similar",
            "insufficient",
            "no_results"
          ]
        },
        "same_variant_verified": {
          "type": "boolean"
        },
        "quality_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_scope": {
          "enum": [
            "physical",
            "local_catalog",
            "external"
          ],
          "description": "Scope of the source independent from source_kind; local/physical evidence cannot masquerade as externally identified facts."
        }
      },
      "required": [
        "source_kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_match_status": {
                "const": "exact_verified"
              }
            },
            "required": [
              "identity_match_status"
            ]
          },
          "then": {
            "required": [
              "external_product_ref",
              "external_variant_ref",
              "match_assessment_ref",
              "variant_verification_ref",
              "same_variant_verified"
            ],
            "properties": {
              "same_variant_verified": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "entity_kind": {
                "const": "set"
              }
