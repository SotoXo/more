                "type": "string",
                "minLength": 1
              },
              "method_ref": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "property_ref",
              "value",
              "unit",
              "method_ref",
              "evidence_refs"
            ]
          }
        }
      },
      "required": [
        "component_ref",
        "fill_description"
