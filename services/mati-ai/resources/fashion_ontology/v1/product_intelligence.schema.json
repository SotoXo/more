                  }
                },
                "required": [
                  "state",
                  "value"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "taxonomy": {
            "properties": {
              "category": {
                "properties": {
                  "state": {
                    "const": "KNOWN"
                  },
                  "value": {
                    "const": "garment.category.coordinated_set"
                  }
                },
