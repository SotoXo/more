    {
      "id": "category:4",
      "document_type": "taxonomy_category",
      "title": "BLUSAS",
      "source": "mati-curated://semantic-foundation/category:4",
      "source_version": "1.0.0",
      "status": "active",
      "metadata": {
        "language": "es",
        "category_ids": [
          4
