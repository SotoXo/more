    {
      "id": "color:observed-vs-commercial",
      "document_type": "color_knowledge",
      "title": "Color observado y color comercial",
      "source": "mati-curated://semantic-foundation/color:observed-vs-commercial",
      "source_version": "1.0.0",
      "status": "active",
      "metadata": {
