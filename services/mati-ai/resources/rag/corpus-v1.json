    {
      "id": "category:11",
      "document_type": "taxonomy_category",
      "title": "POLERA",
      "source": "mati-curated://semantic-foundation/category:11",
      "source_version": "1.0.0",
      "status": "active",
      "metadata": {
        "language": "es",
        "category_ids": [
