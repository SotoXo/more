        "aliases": [
          "POLERA",
          "polera"
        ],
        "source_document": "services/mati-ai/resources/taxonomy/mati-taxonomy-v1.json",
        "source_section": "definition",
        "dynamic_data_authority": false
      },
      "chunks": [
        {
          "id": "category:11#definition",
          "section": "definition",
          "content": "POLERA: categoría Mati activa sin descripción comercial ni grupo de talla. El término varía regionalmente entre camiseta y suéter; en Bolivia ASALE recoge camiseta de manga corta. Ejemplos Mati apuntan a t-shirts, pero no fijan frontera universal con POLOS Y KNITWEAR. Requiere confirmación humana.",
