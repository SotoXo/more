# Python 3.11; never commit a real token. Same token as Laravel.
MATI_AI_TOKEN=
MATI_AI_MODEL_PROVIDER=siglip
# Empty selects the provider default. Set model_revision to a prepared commit for releases.
MATI_AI_VISION_MODEL=
MATI_AI_MODEL_REVISION=main
MATI_AI_DEVICE=auto
MATI_AI_LOCAL_FILES_ONLY=true
MATI_AI_MAX_IMAGE_BYTES=10485760
MATI_AI_MAX_PIXELS=24000000
MATI_AI_OCR_ENABLED=true
MATI_AI_OCR_DOWNLOAD_ENABLED=false
# Optional absolute cache/config paths, not supplied by HTTP clients.
# HF_HOME=/cache/huggingface
# MATI_AI_OCR_MODEL_DIRECTORY=/cache/easyocr
# MATI_AI_EXTERNAL_SOURCES_FILE=/app/config/external-sources.json
