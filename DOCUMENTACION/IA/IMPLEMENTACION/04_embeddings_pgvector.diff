+def _temperature(lab: np.ndarray) -> str:
+    _, a, b = (float(value) for value in lab)
+    chroma = float(np.hypot(a, b))
+    if chroma < 5:
+        return "neutral"
+    if chroma < 30:
+        if b > 5 and a > -8:
+            return "warm_neutral"
+        if b < -5:
+            return "cool_neutral"
+        return "neutral"
+    hue = float(np.degrees(np.arctan2(b, a)) % 360)
+    return "warm" if hue <= 125 or hue >= 345 else "cool"
